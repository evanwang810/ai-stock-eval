# ai-stock-eval config. copy to .env and fill in:   cp .env.example .env
# .env is gitignored, nothing here gets committed.

# ─── used by both the terminal app (main.py) and the watcher ─────────────────

# REQUIRED: LLM API key(s), comma-separated. rotated round-robin across requests.
# free keys at aistudio.google.com/apikey
# NOTE: Gemini free-tier quota is per Google Cloud PROJECT, not per key. Extra
# keys from the same project share one bucket. To actually multiply throughput,
# create each key in a separate project.
LLM_API_KEYS=csk-yourfirstkey,csk-yoursecondkey

# REQUIRED: news headlines for sentiment. free key at finnhub.io
FINNHUB_KEY=

# provider: gemini (default) | cerebras (free tier ending) | groq
LLM_PROVIDER=gemini

# override the model, blank = provider default (gemini -> gemma-4-26b-a4b-it) (cerebras -> gpt-oss-120b)
LLM_MODEL=

# rate limits - blank uses the measured free-tier defaults in llm.py.
# gemma-4-26b-a4b-it free tier: 30 req/min, 15,000 tokens/min. TPM is the
# binding one (an analysis runs ~6.6K tokens), so raise these only if you are
# on a paid tier or spreading keys across projects.
# LLM_RPM=30
# LLM_TPM=15000
# LLM_MAX_TOKENS=10000

# ─── watcher only — the terminal app ignores everything below ────────────────

# override the watcher's ticker list. leave this commented out to use the
# default top-100 list in watcher/config.example.json
# TICKERS=AAPL,MSFT,NVDA

# historical prices for backtests (history.py). free key at alphavantage.co
# ALPHAVANTAGE_API_KEY=
