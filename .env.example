# ai-stock-eval config. copy to .env and fill in:   cp .env.example .env
# .env is gitignored, nothing here gets committed.

# ─── used by both the terminal app (main.py) and the watcher ─────────────────

# REQUIRED: LLM API key(s), comma-separated. rotated round-robin across requests.
# free keys at cloud.cerebras.ai (you can make several on the free plan)
LLM_API_KEYS=csk-yourfirstkey,csk-yoursecondkey

# REQUIRED: news headlines for sentiment. free key at finnhub.io
FINNHUB_KEY=

# provider: cerebras (default) | groq | gemini
LLM_PROVIDER=cerebras

# override the model, blank = provider default (cerebras -> gpt-oss-120b)
LLM_MODEL=

# ─── watcher only — the terminal app ignores everything below ────────────────

# override the watcher's ticker list. leave this commented out to use the
# default top-100 list in watcher/config.example.json
# TICKERS=AAPL,MSFT,NVDA

# historical prices for backtests (history.py). free key at alphavantage.co
# ALPHAVANTAGE_API_KEY=
