# ──────────────────────────────────────────────────────────────────────────────
# ai-stock-eval — environment config
# copy this to ".env" and fill in. .env is gitignored. nothing here gets committed.
#   cp .env.example .env
# everything except LLM_API_KEYS is optional.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED. one or more LLM API keys, comma-separated. the app rotates across
# them round-robin to spread rate-limit load. get free Cerebras keys at
# cloud.cerebras.ai (you can make several on the free plan).
LLM_API_KEYS=csk-yourfirstkey,csk-yoursecondkey

# which provider these keys are for. cerebras | groq | gemini. default: cerebras
LLM_PROVIDER=cerebras

# override the model. leave blank to use the provider default
# (cerebras -> gpt-oss-120b, groq -> openai/gpt-oss-120b, gemini -> gemini-2.5-flash)
LLM_MODEL=

# OPTIONAL. finnhub key — pulls recent news headlines so the model can factor in
# investor sentiment. without it the analysis is fundamentals + price only.
# free key at finnhub.io
FINNHUB_KEY=

# OPTIONAL. alpha vantage key — used by history.py to pull historical daily
# prices from a source other than yfinance (for backtests). free key at
# alphavantage.co/support/#api-key  (note: free tier is ~25 requests/day)
ALPHAVANTAGE_API_KEY=

# OPTIONAL (watcher only). comma-separated tickers to scan. overrides config.json.
TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN
